# ═══════════════════════════════════════════
# Inkspell - Site Configuration
# ═══════════════════════════════════════════
# IMPORTANT: Set NEXT_PUBLIC_SITE_URL to your real domain before building.
# If left as example.com, canonical URLs, sitemap, and robots.txt will all be wrong.

# Your real domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics Measurement ID (leave as G- to disable)
NEXT_PUBLIC_GOOGLE_TAG_ID=G-

# Resource version for cache busting (increment on deploy)
NEXT_PUBLIC_RESOURCE_VERSION=1
